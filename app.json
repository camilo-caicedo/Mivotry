{
  "expo": {
    "name": "Mivotry",
    "slug": "mivotry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2B33",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.mivotry.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_SMS",
        "READ_SMS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "4552c13a-6f4c-4353-9562-d6111d8c39e9"
      }
    }
  }
}
